// riscv.mem — Basic test program

00500113    // ADDI x2, x0, 5       (x2 = 5)
00C00193    // ADDI x3, x0, 12      (x3 = 12)
003100B3    // ADD  x1, x2, x3      (x1 = 5 + 12 = 17)
40310133    // SUB  x2, x2, x3      (x2 = 5 - 12 = -7)
0021a223    // SW   x2, 4(x3)       (mem[12+4] = x2)
0041A283    // LW   x5, 4(x3)       (x5 = mem[12+4] = -7)
00510463    // BEQ  x2, x5, +8      (if x2 == x5, skip next instr)
00000013    // ADDI x0, x0, 0       (NOP — should be skipped)
003281b3    // ADD  x3, x5, x3      (continues here after branch)
123452B7    // LUI x5, 0x12345      (x5 = 12345000)
12345297    // AUIPC x5, 0x12345    (x5 = 1236C)